rules_version = '2';

// Each coach can only read/write their own saved generations.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/generations/{genId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/leadSearches/{searchId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
