# Public application URL. Use the canonical HTTPS origin in production.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Supabase browser-safe project settings.
# Project URL only, e.g. https://xxxx.supabase.co — not the /rest/v1 API path.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase server-only key. Never expose this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe server-only settings.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe price IDs for coach plans. Never hard-code production IDs.
STRIPE_PRICE_SOLO=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ACADEMY=
# Legacy aliases accepted during migration for existing subscriptions.
STRIPE_SOLO_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# Optional: OpenAI key upgrades AI answers from extractive (coach-content quotes)
# to model-written prose. Everything works without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Resend server-only settings.
RESEND_API_KEY=
RESEND_FROM_EMAIL=LessonLeads <leads@lessonleads.com>

# Comma-separated emails allowed to access the internal admin route.
INTERNAL_ADMIN_EMAILS=

# Development and test only. Never enable for a public production deployment.
LESSONLEADS_DEMO_MODE=false
